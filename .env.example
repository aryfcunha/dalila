# Copy to .env and fill in. Never commit .env.

# LLM backend is the `claude` CLI (Claude Code, Pro/Max plan), NOT the API.
# Make sure `claude` is on PATH and `claude --version` works before running Dalila.
# Optional override if `claude` is not on PATH:
DALILA_CLAUDE_BIN=

# Telegram — required for delivery
# Get a token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optional: ACLED API access. Register at https://acleddata.com/register-for-api-access/
# Without these, ACLED ingestion is skipped (everything else still works).
ACLED_API_KEY=
ACLED_EMAIL=

# Optional: IATI Datastore API key (free, requires registration).
# Sign up at https://developer.iatistandard.org/ → request "Datastore" product access.
# The key is mailed to you. Without it, the iati_uae source is silently skipped.
IATI_API_KEY=

# Optional overrides (sensible defaults baked in)
DALILA_DB_PATH=./dalila.db
DALILA_TIMEZONE=Asia/Dubai
DALILA_DIGEST_TIME=06:30
DALILA_INGEST_INTERVAL_MINUTES=30

# Daily-call guardrail — when classifier exceeds this, the pipeline pauses for the day
# (CLI uses your Max plan, no per-call cost, but uncapped runaway loops are still bad).
DALILA_DAILY_CLASSIFIER_CALL_CAP=2000

# Static-site publishing. Set to 1 on the production VM so the bot commits +
# pushes the regenerated site (docs/) to origin/main automatically.
DALILA_SITE_GIT_PUSH=0

# One-shot startup backfill. When > 0, the bot composes any of the last N days
# that are missing a brief, writes their pages, and publishes — once, ~2 min
# after boot, WITHOUT broadcasting the historical briefs to Telegram. Use it to
# recover a backlog automatically: set to 14, restart the service, let it fill.
# Safe to leave on (days that already have a brief cost no LLM call). 0 = off.
DALILA_BACKFILL_DAYS_ON_BOOT=0

# Website URL shown in the /start and /help messages. Use GitHub Pages for public deployment.
DALILA_WEBSITE_URL=https://aryfcunha.github.io/dalila/
